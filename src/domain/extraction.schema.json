{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "newItems",
    "changes",
    "ambiguities",
    "unprocessedQuotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "newItems": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "label",
          "quote",
          "profile",
          "category"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "profile": {
            "enum": [
              "known_model",
              "replacement",
              "fabrication",
              "unknown"
            ],
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemRef",
          "key",
          "status",
          "value",
          "quote",
          "operation",
          "hardConstraint"
        ],
        "properties": {
          "itemRef": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "status": {
            "enum": [
              "known",
              "unknown"
            ],
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "number",
                  "unit"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "number": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 30
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "operation": {
            "enum": [
              "set",
              "correct",
              "hypothetical"
            ],
            "type": "string"
          },
          "hardConstraint": {
            "type": "boolean"
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "unprocessedQuotes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aoki:availability-v2:intake-proposal:1",
  "title": "ExtractionProposal"
}
