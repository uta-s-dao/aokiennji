{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aokiennji-gamma.vercel.app"
        }
      ],
      "destination": "https://aoki-enji.official-b.workers.dev/:path*",
      "permanent": false
    }
  ]
}
