# npm run setup creates .env.local and .local-admin.txt with local-only credentials.
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data
DEMO_MODE=true
ALLOW_LIVE_ORDERS=false
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Set true only behind a trusted proxy that overwrites client forwarding headers.
TRUST_PROXY=false

# Optional adapters. Environment values never go to the browser.
TYPESAFE_API_KEY=
# Direct TypeSafe key: https://api.typesafe.ai
# Vercel AI Gateway key: https://ai-gateway.vercel.sh/typesafe
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Product sourcing uses the real Responses API web search, separately from reply generation.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Opt in when running npm run dev:agent with real Jev + product search.
LOCAL_AGENT_ENABLE_SOURCING=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXA_API_KEY=
TAVILY_API_KEY=

# Supplier/source credentials: configure the variable NAME in the admin console.
# SOURCE_VENDOR_TOKEN=
# SUPPLIER_VENDOR_SECRET=
