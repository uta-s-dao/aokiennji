# npm run setup creates .env.local and .local-admin.txt with local-only credentials.
APP_ORIGIN=http://localhost:3000
# DATA_DIR is used by legacy diagnostic tools, not the Postgres connection.
DATA_DIR=.data
DEMO_MODE=true
ALLOW_LIVE_ORDERS=false
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Set true only behind a trusted proxy that overwrites client forwarding headers.
TRUST_PROXY=false

# Optional adapters. Environment values never go to the browser.
TYPESAFE_API_KEY=
# Direct TypeSafe key: https://api.typesafe.ai
# Vercel AI Gateway key: https://ai-gateway.vercel.sh/typesafe
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Product sourcing uses the real Responses API web search, separately from reply generation.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Opt in when running npm run dev:agent with real Jev + product search.
LOCAL_AGENT_ENABLE_SOURCING=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXA_API_KEY=
TAVILY_API_KEY=

# Supplier/source credentials: configure the variable NAME in the admin console.
# SOURCE_VENDOR_TOKEN=
# SUPPLIER_VENDOR_SECRET=

# Search indexing is opt-in. Enable only after approval on the canonical
# production host, with NODE_ENV=production, DEMO_MODE=false and APP_ORIGIN=SITE_URL.
SITE_URL=https://www.aokieng.co.jp
SEARCH_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
# Free GA4 analytics; disabled until configured and the visitor opts in.
ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=

# UTA-8: server-only Postgres connection; no SQLite fallback.
# Production: dedicated aoki_app member login, verified TLS, transaction pooler.
DATABASE_URL=
# Migration connection is used only by npm run db:migrate, never the web app.
DATABASE_MIGRATION_URL=

# UTA-9: conservative USD conversion, not a market exchange-rate quote.
AI_BUDGET_USD_JPY=160
AI_BUDGET_MARGIN_PERCENT=25
# Jev needs an audited maximum USD per request and its contract version.
# Usage without a verified settlement remains reserved.
AI_JEV_MAX_CALL_USD=
AI_JEV_PRICE_VERSION=

# Stripe: test credentials first. One dedicated customer per site.
# Live keys require explicit enablement after contract confirmation.
BILLING_REQUIRED=false
BILLING_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Fixed JPY monthly tax-inclusive prices: 5,000 / 10,000 / 20,000.
# API cost limits are separate. Set approved allocations before selling.
BILLING_BASIC_PRICE_ID=
BILLING_BASIC_API_LIMIT_JPY=
BILLING_STANDARD_PRICE_ID=
BILLING_STANDARD_API_LIMIT_JPY=
BILLING_PLUS_PRICE_ID=
BILLING_PLUS_API_LIMIT_JPY=
# Schedule /api/billing/notifications every 5 minutes with
# Authorization: Bearer <BUDGET_CRON_SECRET>. Never use a URL query secret.
RESEND_API_KEY=
BUDGET_ALERT_FROM=
BUDGET_ALERT_TO=
BUDGET_CRON_SECRET=
